DB_USER=root
DB_PORT=3306
DB_NAME=GBFDS
DB_PASSWORD=
DB_HOST=localhost
PORT=3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_random_secret

# Used to sign JWTs for the mobile app's API. Generate the same way as
# SESSION_SECRET above (use a different value).
JWT_SECRET=replace_with_a_random_secret

# Used once by `npm run seed` to create the first admin account
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
