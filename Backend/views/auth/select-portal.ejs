<% var title = 'Sign in' %>
<%- include('../partials/head', { title: title }) %>

<div class="auth-page">
    <%- include('../partials/brand-panel') %>

    <main class="form-panel">
        <div class="auth-card surface-card">
            <div class="auth-card__mobile-brand">
                <%- include('../partials/logo', { size: 28 }) %>
                <span>Sentinel</span>
            </div>

            <p class="auth-card__eyebrow">Welcome to Sentinel</p>
            <h2 class="auth-card__title">Choose how you want to sign in</h2>
            <p class="auth-card__subtitle">Accounts are created by an administrator. Select your role to continue.</p>

            <div class="portal-cards">
                <a href="/login/admin" class="portal-card">
                    <span class="portal-card__icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 3l7 3v5c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                            <path d="M9 12.2l2 2 4-4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <span class="portal-card__text">
                        <span class="portal-card__title">Admin</span>
                        <span class="portal-card__desc">Manage accounts and access</span>
                    </span>
                    <svg class="portal-card__arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>

                <a href="/login/analyst" class="portal-card">
                    <span class="portal-card__icon" aria-hidden="true">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M4 20V10M11 20V4M18 20v-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            <circle cx="18" cy="7" r="3" stroke="currentColor" stroke-width="1.6"/>
                        </svg>
                    </span>
                    <span class="portal-card__text">
                        <span class="portal-card__title">Analyst</span>
                        <span class="portal-card__desc">Access the fraud analytics dashboard</span>
                    </span>
                    <svg class="portal-card__arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </a>
            </div>
        </div>
    </main>
</div>

<%- include('../partials/foot') %>
