<% var title = 'Log in' %>
<%- include('../partials/head', { title: title }) %>

<div class="auth-page">
    <%- include('../partials/brand-panel') %>

    <main class="form-panel">
        <div class="auth-card surface-card">
            <div class="auth-card__mobile-brand">
                <%- include('../partials/logo', { size: 28 }) %>
                <span>Sentinel</span>
            </div>

            <p class="auth-card__eyebrow">Welcome back</p>
            <h2 class="auth-card__title">Log in to your account</h2>
            <p class="auth-card__subtitle">Enter your email and password to continue.</p>

            <%- include('../partials/flash', { error: error }) %>

            <form method="POST" action="/auth/login" novalidate>
                <div class="field">
                    <label for="email">Email</label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        autocomplete="email"
                        placeholder="you@company.com"
                        value="<%= typeof email !== 'undefined' ? email : '' %>"
                        required
                    >
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <div class="password-field">
                        <input
                            type="password"
                            id="password"
                            name="password"
                            autocomplete="current-password"
                            placeholder="••••••••"
                            required
                        >
                        <button type="button" class="password-toggle" data-toggle-for="password" aria-label="Show password" aria-pressed="false">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <path d="M1.5 10S4.5 4 10 4s8.5 6 8.5 6-3 6-8.5 6-8.5-6-8.5-6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                                <circle cx="10" cy="10" r="2.25" stroke="currentColor" stroke-width="1.5"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-primary" data-submit-label="Log in" data-loading-label="Logging in…">Log in</button>
            </form>

            <p class="auth-card__switch">Don't have an account? <a href="/signup">Sign up</a></p>
        </div>
    </main>
</div>

<script src="/js/auth.js"></script>
<%- include('../partials/foot') %>
