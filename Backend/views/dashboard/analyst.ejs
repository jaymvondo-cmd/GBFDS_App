<% var title = 'Dashboard' %>
<%- include('../partials/head', { title: title }) %>

<div class="app-shell">
    <%- include('../partials/app-sidebar', { user: user, active: active }) %>

    <div class="app-main-column">
        <%- include('../partials/app-topbar', { user: user }) %>

    <main class="app-content">
        <%- include('../partials/greeting-card', {
            user: user,
            subtitle: 'Here\'s your fraud activity overview.',
            iconColor: { bg: 'rgba(220, 38, 38, 0.1)', fg: '#dc2626' },
        }) %>

        <div class="stat-row">
            <div class="surface-card stat-tile">
                <span class="stat-tile__icon stat-tile__icon--red" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M10 2.5l7 12.5a1 1 0 0 1-.87 1.5H3.87A1 1 0 0 1 3 15L10 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        <path d="M10 8v3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <circle cx="10" cy="13.8" r="0.9" fill="currentColor"/>
                    </svg>
                </span>
                <div class="stat-tile__body">
                    <p class="stat-tile__label">Pending alerts</p>
                    <p class="stat-tile__value skeleton" id="stat-active-alerts" aria-live="polite">00</p>
                </div>
            </div>

            <div class="surface-card stat-tile">
                <span class="stat-tile__icon" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <path d="M4 17V10M10 17V4M16 17v-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </span>
                <div class="stat-tile__body">
                    <p class="stat-tile__label">Total transactions</p>
                    <p class="stat-tile__value skeleton" id="stat-total-transactions" aria-live="polite">00</p>
                </div>
            </div>

            <div class="surface-card stat-tile">
                <span class="stat-tile__icon stat-tile__icon--red" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                        <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M10 6.5v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <circle cx="10" cy="13" r="0.9" fill="currentColor"/>
                    </svg>
                </span>
                <div class="stat-tile__body">
                    <p class="stat-tile__label">Flagged as fraud</p>
                    <p class="stat-tile__value skeleton" id="stat-red-count" aria-live="polite">00</p>
                </div>
            </div>
        </div>

        <div class="dashboard-grid">
            <div class="surface-card chart-card">
                <h2 class="chart-card__title">Transactions by risk level</h2>
                <p class="chart-card__subtitle">OK (legitimate), Low (suspicious), High (fraud)</p>
                <div class="chart-card__canvas-wrap chart-card__canvas-wrap--short skeleton" id="chart-risk-wrap">
                    <canvas id="chart-risk-breakdown" aria-label="Bar chart of transactions by risk level: OK, Low, High" role="img"></canvas>
                </div>
            </div>
        </div>

        <div class="page-header page-header--tight">
            <div>
                <h2 class="section-title">Recent pending alerts</h2>
            </div>
        </div>

        <div class="surface-card table-card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Alert ID</th>
                            <th>Risk</th>
                            <th>Amount</th>
                            <th>Reason</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody id="recent-alerts-body">
                        <tr>
                            <td colspan="5" class="data-table__empty">Loading…</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="/js/analystDashboard.js"></script>
<%- include('../partials/foot') %>
