<% var title = 'Dashboard' %>
<%- include('../partials/head', { title: title }) %>

<div class="app-shell">
    <header class="app-header">
        <div class="app-header__lockup">
            <%- include('../partials/logo', { size: 28, color: '#2f8ff0' }) %>
            <span>Sentinel</span>
        </div>
        <div class="app-header__user">
            <span><%= user.prename %> <%= user.name %></span>
            <span class="role-badge"><%= user.role %></span>
            <form method="POST" action="/auth/logout">
                <button type="submit" class="btn-ghost">Log out</button>
            </form>
        </div>
    </header>

    <main class="app-main">
        <div>
            <h1>You're logged in, <%= user.prename %>.</h1>
            <p>The analyst dashboard with charts lands in a later phase. This page confirms the login flow works end to end.</p>
        </div>
    </main>
</div>

<%- include('../partials/foot') %>
