<%
  var isAdmin = user.role === 'admin';
  var initial = (user.prename || user.name || '?').charAt(0).toUpperCase();
  var fullName = ((user.prename || '') + ' ' + (user.name || '')).trim();
%>
<div class="app-topbar">
    <div class="app-topbar__spacer"></div>

    <div class="profile-menu" data-profile-menu>
        <button type="button" class="profile-menu__trigger" data-profile-trigger
                aria-haspopup="true" aria-expanded="false" aria-label="Your account">
            <span class="status-dot status-dot--online" aria-hidden="true"></span>
            <span class="app-topbar__name"><%= fullName %></span>
            <span class="app-topbar__avatar">
                <%= initial %>
                <span class="app-topbar__avatar-status" aria-hidden="true"></span>
            </span>
        </button>

        <div class="profile-menu__panel" data-profile-panel hidden>
            <div class="profile-menu__header">
                <span class="app-topbar__avatar app-topbar__avatar--lg">
                    <%= initial %>
                    <span class="app-topbar__avatar-status" aria-hidden="true"></span>
                </span>
                <div class="profile-menu__identity">
                    <p class="profile-menu__name"><%= fullName %></p>
                    <p class="profile-menu__email"><%= user.email %></p>
                </div>
            </div>

            <div class="profile-menu__meta">
                <span class="role-badge <%= isAdmin ? 'role-badge--admin' : '' %>"><%= user.role %></span>
                <span class="connected-pill">
                    <span class="status-dot status-dot--online" aria-hidden="true"></span>
                    Connected
                </span>
            </div>

            <div class="profile-menu__links">
                <a href="/profile" class="profile-menu__link">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <circle cx="10" cy="6.5" r="3" stroke="currentColor" stroke-width="1.6"/>
                        <path d="M4 17c0-3 2.7-5 6-5s6 2 6 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                    My profile
                </a>
                <% if (isAdmin) { %>
                    <a href="/admin/system" class="profile-menu__link">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M2.5 10.5h3l2-5 3 9 2-4h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        System health
                    </a>
                <% } else { %>
                    <a href="/alerts?status=pending" class="profile-menu__link">
                        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M10 2.5l7 12.5a1 1 0 0 1-.87 1.5H3.87A1 1 0 0 1 3 15L10 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                        </svg>
                        My alert queue
                    </a>
                <% } %>
            </div>

            <form method="POST" action="/auth/logout" class="profile-menu__logout">
                <button type="submit" class="profile-menu__link profile-menu__link--danger">
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M7.5 17H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M13 13.5l4-3.5-4-3.5M17 10H7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Log out
                </button>
            </form>
        </div>
    </div>
</div>

<script src="/js/topbar.js"></script>
