<%
  var isAdmin = user.role === 'admin';
%>
<aside class="app-sidebar">
    <a href="/dashboard" class="app-sidebar__logo" aria-label="Sentinel home">
        <%- include('logo', { size: 26 }) %>
    </a>

    <nav class="app-sidebar__nav">
        <a href="/dashboard" class="app-sidebar__link <%= active === 'dashboard' ? 'is-active' : '' %>" aria-label="Dashboard" title="Dashboard">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="2.5" y="2.5" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
                <rect x="11" y="2.5" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
                <rect x="2.5" y="11" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
                <rect x="11" y="11" width="6.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
            </svg>
        </a>

        <a href="/alerts" class="app-sidebar__link <%= active === 'alerts' ? 'is-active' : '' %>" aria-label="Alerts" title="Alerts">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 2.5l7 12.5a1 1 0 0 1-.87 1.5H3.87A1 1 0 0 1 3 15L10 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M10 8v3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                <circle cx="10" cy="13.8" r="0.9" fill="currentColor"/>
            </svg>
        </a>

        <a href="/transactions" class="app-sidebar__link <%= active === 'transactions' ? 'is-active' : '' %>" aria-label="Transactions" title="Transactions">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M3 6.5h11M11.5 4l2.5 2.5-2.5 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M17 13.5H6M8.5 11L6 13.5 8.5 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>

        <a href="/graph" class="app-sidebar__link <%= active === 'graph' ? 'is-active' : '' %>" aria-label="Money flow map" title="Money flow map">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="4.5" cy="5" r="2.2" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="15.5" cy="5" r="2.2" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="10" cy="15.5" r="2.2" stroke="currentColor" stroke-width="1.6"/>
                <path d="M6.6 5.9l6.8 0M5.6 7l3 6.5M14.4 7l-3 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </a>

        <% if (isAdmin) { %>
        <span class="app-sidebar__divider" aria-hidden="true"></span>

        <a href="/admin/users" class="app-sidebar__link app-sidebar__link--admin <%= active === 'users' ? 'is-active' : '' %>" aria-label="Manage users" title="Manage users">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M2 17c0-2.8 2.2-5 5-5s5 2.2 5 5M15 9.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM17 17c0-2-1-3.6-2.5-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="7" cy="7" r="3" stroke="currentColor" stroke-width="1.6"/>
            </svg>
        </a>

        <a href="/admin/rules" class="app-sidebar__link app-sidebar__link--admin <%= active === 'rules' ? 'is-active' : '' %>" aria-label="Detection rules" title="Detection rules">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M4 6h12M4 10h12M4 14h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                <circle cx="14.5" cy="14" r="2.2" stroke="currentColor" stroke-width="1.6"/>
            </svg>
        </a>

        <a href="/admin/system" class="app-sidebar__link app-sidebar__link--admin <%= active === 'system' ? 'is-active' : '' %>" aria-label="System health" title="System health">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M2.5 10.5h3l2-5 3 9 2-4h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>

        <a href="/admin/audit" class="app-sidebar__link app-sidebar__link--admin <%= active === 'audit' ? 'is-active' : '' %>" aria-label="Audit logs" title="Audit logs">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 2.5h7L15.5 6v11.5h-11V2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M11.5 2.5V6h4M7 10h6M7 13h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </a>
        <% } %>
    </nav>

    <form method="POST" action="/auth/logout" class="app-sidebar__logout">
        <button type="submit" class="app-sidebar__link" aria-label="Log out" title="Log out">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M7.5 17H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M13 13.5l4-3.5-4-3.5M17 10H7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </form>
</aside>
