<%
    // Sentinel mark: a shield holding a small transaction network, with one
    // node picked out in red — the account a rule just flagged. That's the
    // whole product in one icon: watch the flow of money, catch the node
    // that doesn't look right.
    //
    // Param: size (defaults to 40). Gradient ids get a random suffix so the
    // mark can be included more than once on the same page (sidebar +
    // brand panel, for example) without one instance's <defs> silently
    // overriding another's.
    var logoSize = typeof size !== 'undefined' ? size : 40;
    var uid = Math.random().toString(36).slice(2, 8);
%>
<svg
    class="sentinel-logo"
    width="<%= logoSize %>"
    height="<%= logoSize %>"
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Sentinel logo"
>
    <defs>
        <linearGradient id="sentinelShield-<%= uid %>" x1="17" y1="4" x2="83" y2="97" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#5fb0ff" />
            <stop offset="55%" stop-color="#2f6fe0" />
            <stop offset="100%" stop-color="#173d8a" />
        </linearGradient>
        <linearGradient id="sentinelRibbon-<%= uid %>" x1="24" y1="14" x2="66" y2="86" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#123069" />
            <stop offset="100%" stop-color="#1c4f9e" />
        </linearGradient>
    </defs>

    <!-- shield -->
    <path
        fill="url(#sentinelShield-<%= uid %>)"
        d="M50,4 L83,19 V51 C83,74 68,89 50,97 C32,89 17,74 17,51 V19 Z"
    />

    <!-- ribbon "S", the twist that turns the shield into Sentinel's mark -->
    <path
        fill="url(#sentinelRibbon-<%= uid %>)"
        opacity="0.85"
        d="M63,15 C48,15 43,25 51,33 C61,43 57,53 45,53 C35,53 31,61 35,69
           C39,77 47,83 59,85 L59,73 C51,73 47,67 51,61 C43,53 47,43 57,43
           C69,43 73,33 67,25 C64,21 63,18 63,15 Z"
    />

    <!-- the transaction network sitting inside the ribbon, one node flagged -->
    <g stroke="#bcd7ff" stroke-width="1.7" stroke-linecap="round" opacity="0.9">
        <line x1="50" y1="49" x2="38" y2="39" />
        <line x1="50" y1="49" x2="64" y2="37" />
        <line x1="50" y1="49" x2="67" y2="58" />
        <line x1="50" y1="49" x2="41" y2="64" />
    </g>
    <circle cx="38" cy="39" r="4" fill="#8ec2ff" />
    <circle cx="64" cy="37" r="4.4" fill="#d7e9ff" />
    <circle cx="67" cy="58" r="4" fill="#8ec2ff" />
    <circle cx="41" cy="64" r="4" fill="#d7e9ff" />
    <circle cx="50" cy="49" r="5.6" fill="#ef4444" />
</svg>
