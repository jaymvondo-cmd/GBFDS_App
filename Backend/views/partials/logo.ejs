<%# Sentinel mark: flame + brick wall. Params: size, color (wall), fireColor (flame) %>
<svg
    class="sentinel-logo"
    width="<%= typeof size !== 'undefined' ? size : 40 %>"
    height="<%= typeof size !== 'undefined' ? size : 40 %>"
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Sentinel logo"
>
    <!-- brick wall -->
    <g fill="<%= typeof color !== 'undefined' ? color : '#2f8ff0' %>">
        <rect x="40" y="12" width="18" height="20" rx="1.5" />
        <rect x="60" y="12" width="18" height="20" rx="1.5" />
        <rect x="80" y="12" width="18" height="20" rx="1.5" />

        <rect x="50" y="34" width="18" height="20" rx="1.5" />
        <rect x="70" y="34" width="18" height="20" rx="1.5" />
        <rect x="90" y="34" width="14" height="20" rx="1.5" />

        <rect x="40" y="56" width="18" height="20" rx="1.5" />
        <rect x="60" y="56" width="18" height="20" rx="1.5" />
        <rect x="80" y="56" width="18" height="20" rx="1.5" />
    </g>

    <!-- flame -->
    <path
        fill="<%= typeof fireColor !== 'undefined' ? fireColor : '#dc2626' %>"
        d="M27,7
           C35,17 41,25 39,35
           C45,29 47,39 45,49
           C51,43 51,55 47,63
           C43,73 33,80 23,80
           C11,80 4,68 6,56
           C7,47 12,43 14,37
           C10,33 8,27 10,19
           C12,25 16,27 18,23
           C16,17 20,9 27,7 Z"
    />
</svg>
