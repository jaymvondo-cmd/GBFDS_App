<%
  var isEdit = mode === 'edit';
  var title = isEdit ? 'Edit rule' : 'New rule';
  var formAction = isEdit ? ('/admin/rules/' + ruleId) : '/admin/rules';
%>
<%- include('../../partials/head', { title: title }) %>

<div class="app-shell">
    <%- include('../../partials/app-sidebar', { user: user, active: active }) %>

    <div class="app-main-column">
        <%- include('../../partials/app-topbar', { user: user }) %>

        <main class="app-content app-content--narrow">
            <a href="/admin/rules" class="auth-card__back">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M9.5 3.5L5 8l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Back to rules
            </a>

            <h1 class="page-header__title"><%= isEdit ? 'Edit rule' : 'Create a detection rule' %></h1>
            <p class="page-header__subtitle">Each rule that fires on a transaction adds its weight to that transaction's risk score.</p>

            <%- include('../../partials/flash', { error: error }) %>

            <div class="surface-card form-card">
                <form method="POST" action="<%= formAction %>" novalidate>
                    <div class="field">
                        <label for="rule_name">Rule name</label>
                        <input type="text" id="rule_name" name="rule_name" value="<%= values.rule_name || '' %>" required>
                    </div>

                    <div class="field">
                        <label for="description">Description</label>
                        <textarea id="description" name="description" rows="2" placeholder="What does this rule catch?"><%= values.description || '' %></textarea>
                    </div>

                    <div class="field">
                        <label for="rule_type">Type</label>
                        <select id="rule_type" name="rule_type" required>
                            <% ruleTypes.forEach(function (t) { %>
                                <option value="<%= t.value %>" <%= values.rule_type === t.value ? 'selected' : '' %>><%= t.label %></option>
                            <% }) %>
                        </select>
                        <p class="hint">The type decides which check the engine runs. Custom types are stored but not evaluated until the engine supports them.</p>
                    </div>

                    <div class="field">
                        <label for="condition_field">Condition field</label>
                        <input type="text" id="condition_field" name="condition_field" value="<%= values.condition_field || '' %>" placeholder="e.g. amount">
                    </div>

                    <div class="field-row">
                        <div class="field">
                            <label for="threshold">Threshold</label>
                            <input type="number" id="threshold" name="threshold" step="any" value="<%= values.threshold !== undefined ? values.threshold : '' %>" required>
                            <p class="hint">The number this rule compares against.</p>
                        </div>
                        <div class="field">
                            <label for="weight">Weight</label>
                            <input type="number" id="weight" name="weight" step="0.05" min="0.05" max="1" value="<%= values.weight !== undefined ? values.weight : '' %>" required>
                            <p class="hint">Between 0 and 1.</p>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/admin/rules" class="btn-secondary">Cancel</a>
                        <button type="submit" class="btn-primary btn-primary--inline"><%= isEdit ? 'Save changes' : 'Create rule' %></button>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>

<%- include('../../partials/foot') %>
