<% var title = 'System health' %>
<%- include('../partials/head', { title: title }) %>

<div class="app-shell">
    <%- include('../partials/app-sidebar', { user: user, active: active }) %>

    <div class="app-main-column">
        <%- include('../partials/app-topbar', { user: user }) %>

        <main class="app-content">
            <div class="page-header">
                <div>
                    <h1 class="page-header__title">System health</h1>
                    <p class="page-header__subtitle">What the fraud detection system is holding and doing right now.</p>
                </div>
            </div>

            <div class="stat-row">
                <div class="surface-card stat-tile">
                    <span class="stat-tile__icon stat-tile__icon--red" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M10 2.5l7 12.5a1 1 0 0 1-.87 1.5H3.87A1 1 0 0 1 3 15L10 2.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                            <path d="M10 8v3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        </svg>
                    </span>
                    <div class="stat-tile__body">
                        <p class="stat-tile__label">Alerts awaiting review</p>
                        <p class="stat-tile__value"><%= stats.pendingAlerts %></p>
                    </div>
                </div>

                <div class="surface-card stat-tile">
                    <span class="stat-tile__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M3 6.5h11M11.5 4l2.5 2.5-2.5 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M17 13.5H6M8.5 11L6 13.5 8.5 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    <div class="stat-tile__body">
                        <p class="stat-tile__label">Transactions processed</p>
                        <p class="stat-tile__value"><%= stats.totalTransactions %></p>
                    </div>
                </div>

                <div class="surface-card stat-tile">
                    <span class="stat-tile__icon" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M4 6h12M4 10h12M4 14h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                            <circle cx="14.5" cy="14" r="2.2" stroke="currentColor" stroke-width="1.6"/>
                        </svg>
                    </span>
                    <div class="stat-tile__body">
                        <p class="stat-tile__label">Active rules</p>
                        <p class="stat-tile__value"><%= stats.activeRules %><span class="stat-tile__suffix">/ <%= stats.totalRules %></span></p>
                    </div>
                </div>
            </div>

            <div class="detail-grid">
                <div class="surface-card detail-card">
                    <h2 class="chart-card__title">Transactions by risk level</h2>
                    <p class="chart-card__subtitle">Red is anything scoring above the current threshold of <%= stats.threshold %>.</p>
                    <% var totalTx = stats.totalTransactions || 1; %>
                    <ul class="meter-list">
                        <% [['green','Green (legitimate)'],['yellow','Yellow (suspicious)'],['red','Red (fraud)']].forEach(function (pair) {
                             var key = pair[0]; var label = pair[1];
                             var count = byClassification[key];
                             var pct = Math.round((count / totalTx) * 100); %>
                            <li>
                                <div class="meter-list__head">
                                    <span><%= label %></span>
                                    <strong><%= count %> <span class="meter-list__pct"><%= pct %>%</span></strong>
                                </div>
                                <div class="meter-track">
                                    <div class="meter-fill meter-fill--<%= key %>" style="width: <%= pct %>%"></div>
                                </div>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <div class="surface-card detail-card">
                    <h2 class="chart-card__title">Alerts by status</h2>
                    <p class="chart-card__subtitle">How the analyst team is working through the queue.</p>
                    <ul class="meter-list">
                        <% var totalAlerts = stats.totalAlerts || 1; %>
                        <% [['pending','Pending'],['confirmed','Confirmed fraud'],['dismissed','Dismissed'],['escalated','Escalated']].forEach(function (pair) {
                             var key = pair[0]; var label = pair[1];
                             var count = byAlertStatus[key];
                             var pct = Math.round((count / totalAlerts) * 100); %>
                            <li>
                                <div class="meter-list__head">
                                    <span><%= label %></span>
                                    <strong><%= count %> <span class="meter-list__pct"><%= pct %>%</span></strong>
                                </div>
                                <div class="meter-track">
                                    <div class="meter-fill meter-fill--<%= key %>" style="width: <%= pct %>%"></div>
                                </div>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            </div>

            <div class="page-header page-header--tight">
                <div>
                    <h2 class="section-title">Recent activity</h2>
                </div>
                <a href="/admin/audit" class="btn-secondary btn-secondary--sm">View full audit log</a>
            </div>

            <div class="surface-card table-card">
                <div class="table-scroll">
                    <table class="data-table">
                        <thead><tr><th>Action</th><th>Details</th><th>When</th></tr></thead>
                        <tbody>
                            <% if (recentActivity.length === 0) { %>
                                <tr><td colspan="3" class="data-table__empty">No activity recorded yet.</td></tr>
                            <% } %>
                            <% recentActivity.forEach(function (log) { %>
                                <tr>
                                    <td class="data-table__name"><%= log.action %></td>
                                    <td class="cell-wrap"><%= log.details || '—' %></td>
                                    <td><%= new Date(log.created_at).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>
</div>

<%- include('../partials/foot') %>
